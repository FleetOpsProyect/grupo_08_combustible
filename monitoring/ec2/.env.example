# Copy to .env in this folder (cp .env.example .env). Never commit .env
# Public IP or DNS of the EC2 instance (changes on restart unless it has an Elastic IP)
EC2_HOST=0.0.0.0

# Non-standard local ports of the monitoring dojo
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
