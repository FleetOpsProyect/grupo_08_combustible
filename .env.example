# ─── Copy to .env (cp .env.example .env) and change the values. Never commit .env ───
# The same file is used by docker compose and by the service when it runs from the IDE.
# Inside docker compose, DB_URL, ASSIGNMENTS_BASE_URL and ROUTES_BASE_URL are replaced by the
# addresses of the compose network (see docker-compose.yml).

# Port where the service listens
SERVER_PORT=8080
# Port published on the host machine by docker compose for the service
APP_PORT=8088

# PostgreSQL 16 of the service (database per service)
DB_NAME=fleetops_fuel
DB_USER=fuel_user
DB_PASSWORD=change_me_local_password
# JDBC URL used when the service runs from the IDE
DB_URL=jdbc:postgresql://localhost:5433/fleetops_fuel
# Port published on the host by docker compose for PostgreSQL (5433 so it does not clash with a native PostgreSQL on 5432)
DB_HOST_PORT=5433

# Time zone of every date of the service (shared convention: Colombia, GMT-5)
APP_TIME_ZONE=America/Bogota

# Anomaly rule (G08 decision, 15 Oct 2026): drop in percent against the vehicle average
ANOMALY_THRESHOLD_PERCENT=30
# Previous non anomalous efficiencies needed before evaluating a vehicle
ANOMALY_MINIMUM_SAMPLES=2

# Outbox relay: milliseconds between runs and events published per run
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50

# Assignments (G2). Points to the WireMock simulator until G2 is deployed
ASSIGNMENTS_BASE_URL=http://localhost:8089
# Value of "state" in GET /assignment/{id} that means "in progress" (contract in English, snake_case)
ASSIGNMENT_IN_PROGRESS_STATE=IN_PROGRESS

# Telemetry and Routes (G6). Points to the WireMock simulator until G6 is deployed
ROUTES_BASE_URL=http://localhost:8089
# Value of the "status" filter of GET /routes for a route in progress
ROUTE_IN_PROGRESS_STATUS=IN_PROGRESS
# Port published on the host by docker compose for the WireMock simulator of G2 and G6
MOCK_HOST_PORT=8089

# Timeout of every call to another service, in milliseconds (DAS: 2 seconds)
HTTP_TIMEOUT_MS=2000

# Circuit Breaker: failure percent that opens the circuit
CB_FAILURE_RATE_THRESHOLD=50
# Calls kept in the sliding window
CB_SLIDING_WINDOW_SIZE=10
# Calls needed before the failure rate is evaluated
CB_MINIMUM_CALLS=5
# Milliseconds the circuit stays open before trying again
CB_WAIT_OPEN_MS=30000
